# Select dev locally, prod for a separately configured HTTPS deployment.
DJANGO_SETTINGS_MODULE=enviroinsights.settings.dev
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
# Comma-separated hostnames without schemes.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
# Comma-separated scheme + host + port origins for browser POSTs.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Enable only behind a trusted HTTPS proxy that strips untrusted forwarding headers.
DJANGO_TRUST_PROXY=False
# Container database creation parameters (development superuser; see README for prod).
POSTGRES_DB=enviroinsights
POSTGRES_USER=enviroinsights
POSTGRES_PASSWORD=replace-with-a-random-password
# Keep password consistent with POSTGRES_PASSWORD; URL-encode special characters.
DATABASE_URL=postgis://enviroinsights:replace-with-a-random-password@db:5432/enviroinsights
# PostgreSQL persistent connection lifetime in seconds; tests override to zero.
DB_CONN_MAX_AGE=60
# Separate Redis databases for health checks and the Celery task broker.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
# Dedicated disposable test database; the name must differ from POSTGRES_DB.
TEST_DATABASE_NAME=test_enviroinsights
# Network health probe timeout in seconds.
HEALTH_CHECK_TIMEOUT=2
# Time-series admin counts/pages stop at this many matches (minimum 100).
ADMIN_COUNT_CAP=10000
# Console logging verbosity.
LOG_LEVEL=INFO
# Loopback-only published host ports. Containers always use their standard ports.
WEB_PORT=8000
# Use 5433 to coexist with a native Windows PostgreSQL service on 5432.
POSTGRES_PORT=5433
MLFLOW_PORT=5000
# Use 6380 to coexist with a native Windows Redis service on 6379.
REDIS_PORT=6380
FLOWER_PORT=5555
# Flower HTTP Basic authentication: username:password (use a random password).
FLOWER_BASIC_AUTH=curator:replace-with-a-random-password
# Optional native GeoDjango library paths; Linux containers auto-discover libraries.
GEOS_LIBRARY_PATH=
GDAL_LIBRARY_PATH=
# WAIT_FOR_MIGRATIONS is controlled by Compose for worker/beat/flower; do not set it here.
# Optional ingestion credentials. Missing keys create skipped runs; public sources work without them.
# https://explore.openaq.org/register
OPENAQ_API_KEY=
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# https://cds.climate.copernicus.eu/how-to-api (personal access token; accept ERA5 licence)
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=
FIRMS_BBOX=73,27,78,33
INGEST_HTTP_TIMEOUT=120
INGEST_HTTP_ATTEMPTS=4
INGEST_BATCH_SIZE=2000
INGEST_REQUEST_PAUSE=1
OBSERVATION_API_MAX_DAYS=31
